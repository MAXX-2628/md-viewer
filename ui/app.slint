import { ScrollView } from "std-widgets.slint";

export struct DocBlock {
    kind: int,
    content: styled-text,
    text: string,
    marker: string,
    indent: int,
    scale: float,
}

// Segoe MDL2 Assets ships with Windows 10 and 11.
global Icons {
    out property <string> font: "Segoe MDL2 Assets";
    out property <string> open: "\u{E8E5}";
    out property <string> reload: "\u{E72C}";
    out property <string> copy: "\u{E8C8}";
    out property <string> zoom-out: "\u{E71F}";
    out property <string> zoom-in: "\u{E8A3}";
    out property <string> moon: "\u{E708}";
    out property <string> sun: "\u{E706}";
    out property <string> more: "\u{E712}";
    out property <string> doc: "\u{E8A5}";
}

global Theme {
    in-out property <bool> dark: false;
    out property <color> accent: #0a66c2;
    out property <color> accent-hover: #0959a8;
    out property <color> window-bg: dark ? #17181b : #eef0f3;
    out property <color> chrome-bg: dark ? #1f2125 : #ffffff;
    out property <color> chrome-border: dark ? #2e3136 : #dde1e6;
    out property <color> surface: dark ? #1f2125 : #ffffff;
    out property <color> hover: dark ? #2c2f35 : #eef1f5;
    out property <color> pressed: dark ? #363a41 : #e1e6ec;
    out property <color> text-main: dark ? #e6e8eb : #1b1f24;
    out property <color> text-body: dark ? #c9cdd2 : #2f353c;
    out property <color> text-muted: dark ? #8b929b : #6b7380;
    out property <color> border: dark ? #33373d : #e3e6ea;
    out property <color> link: dark ? #6cb6ff : #0a66c2;
    out property <color> selection-bg: dark ? #264f78 : #b6d7fb;
    out property <color> code-bg: dark ? #17191c : #f6f8fa;
    out property <color> code-border: dark ? #2e3238 : #e1e4e8;
    out property <color> quote-bar: dark ? #3d6fa8 : #9cc3ea;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();

    height: 32px;
    min-width: 32px;
    border-radius: 6px;
    background: root.primary
        ? (tap.pressed ? Theme.accent-hover : tap.has-hover ? Theme.accent-hover : Theme.accent)
        : (tap.pressed ? Theme.pressed : tap.has-hover ? Theme.hover : transparent);

    tap := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: root.label == "" ? 0px : 10px;
        padding-right: root.label == "" ? 0px : 12px;
        spacing: 8px;
        alignment: center;

        if root.icon != "" : Text {
            text: root.icon;
            font-family: Icons.font;
            font-size: 14px;
            color: root.primary ? #ffffff : Theme.text-main;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        if root.label != "" : Text {
            text: root.label;
            font-size: 13px;
            font-weight: 600;
            color: root.primary ? #ffffff : Theme.text-main;
            vertical-alignment: center;
        }
    }
}

component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> hint;
    callback clicked();

    height: 34px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Text {
            width: 16px;
            text: root.icon;
            font-family: Icons.font;
            font-size: 13px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: Theme.text-main;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.hint;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// macOS-style window controls; glyphs appear while the group is hovered.
component TrafficLight inherits Rectangle {
    in property <color> fill;
    in property <string> glyph;
    in property <bool> show-glyph;
    callback clicked();

    width: 13px;
    height: 13px;
    border-radius: 6.5px;
    background: tap.pressed ? fill.darker(20%) : fill;
    border-width: 0.5px;
    border-color: fill.darker(15%);

    tap := TouchArea {
        clicked => { root.clicked(); }
    }

    if root.show-glyph : Text {
        text: root.glyph;
        color: #00000099;
        font-size: 11px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Divider inherits Rectangle {
    width: 1px;
    height: 20px;
    background: Theme.chrome-border;
}

export component MainWindow inherits Window {
    in property <[DocBlock]> blocks;
    in property <int> word-count: 0;
    in property <string> status-text: "Open a .md file";
    in property <string> document-title: "Untitled";
    in property <bool> has-document: false;
    in-out property <float> zoom: 1.0;
    in-out property <bool> dark: false;

    callback open-file();
    callback reload();
    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();
    callback toggle-theme();
    callback copy-source();
    callback load-sample();
    callback set-default();
    callback open-link(string);
    callback minimize-window();
    callback close-window();

    // Reading column width, grows with zoom so lines keep the same word count.
    property <length> column: 820px * root.zoom;

    changed dark => { Theme.dark = root.dark; }
    init => { Theme.dark = root.dark; }

    title: root.has-document ? root.document-title + " - MD Viewer" : "MD Viewer";
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 640px;
    min-height: 420px;
    // Frameless: the toolbar is the title bar. Transparent so the frame can have rounded corners.
    no-frame: true;
    background: transparent;
    icon: @image-url("logo.png");
    default-font-family: "Segoe UI";
    default-font-size: 16px;
    forward-focus: focus;

    // Wraps the whole UI so shortcuts still fire after focus moves into selectable text.
    focus := FocusScope {
        width: root.width;
        height: root.height;

        frame := Rectangle {
          border-radius: root.maximized ? 0px : 10px;
          clip: true;
          background: Theme.window-bg;

          VerticalLayout {
            spacing: 0px;

            // Toolbar
            Rectangle {
                height: 52px;
                background: Theme.chrome-bg;

              WindowMoveArea {
                TouchArea {
                    double-clicked => { root.maximized = !root.maximized; }
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 4px;
                    alignment: stretch;

                    lights := TouchArea {
                        width: 60px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                TrafficLight { fill: #ff5f57; glyph: "×"; show-glyph: lights.has-hover; clicked => { root.close-window(); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                TrafficLight { fill: #febc2e; glyph: "−"; show-glyph: lights.has-hover; clicked => { root.minimize-window(); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                TrafficLight { fill: #28c840; glyph: "+"; show-glyph: lights.has-hover; clicked => { root.maximized = !root.maximized; } }
                            }
                        }
                    }

                    Rectangle { width: 14px; }

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("logo.png");
                            width: 24px;
                            height: 24px;
                        }
                    }

                    Rectangle { width: 6px; }

                    Text {
                        text: "MD Viewer";
                        color: Theme.text-main;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    if root.has-document : Text {
                        text: "  /  " + root.document-title;
                        color: Theme.text-muted;
                        font-size: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 40px;
                    }

                    if !root.has-document : Rectangle { horizontal-stretch: 1; }

                    Rectangle { width: 12px; }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 2px;
                            IconButton { icon: Icons.open; label: "Open"; clicked => { root.open-file(); } }
                            IconButton { icon: Icons.reload; label: "Reload"; clicked => { root.reload(); } }
                            IconButton { icon: Icons.copy; width: 32px; clicked => { root.copy-source(); } }
                        }
                    }

                    VerticalLayout { alignment: center; Divider {} }

                    // Zoom segment
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 0px;
                            IconButton { icon: Icons.zoom-out; width: 32px; clicked => { root.zoom-out(); } }
                            Rectangle {
                                width: 56px;
                                height: 32px;
                                border-radius: 6px;
                                background: reset.has-hover ? Theme.hover : transparent;
                                reset := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.zoom-reset(); }
                                }
                                Text {
                                    text: "\{(root.zoom * 100).round()}%";
                                    color: Theme.text-main;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                            }
                            IconButton { icon: Icons.zoom-in; width: 32px; clicked => { root.zoom-in(); } }
                        }
                    }

                    VerticalLayout { alignment: center; Divider {} }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 2px;
                            IconButton {
                                icon: root.dark ? Icons.sun : Icons.moon;
                                width: 32px;
                                clicked => { root.toggle-theme(); }
                            }
                            IconButton {
                                icon: Icons.more;
                                width: 32px;
                                clicked => { menu-popup.show(); }
                            }
                        }
                    }
                }
              }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.chrome-border;
                }
            }

            // Document
            if root.has-document : scroll := ScrollView {
                vertical-stretch: 1;
                // Flickable does not pick up the page's explicit height on its own.
                content-height: page.height;

                page := Rectangle {
                    width: scroll.visible-width;
                    // Explicit height: without it the page matches the viewport and never scrolls.
                    height: max(content.preferred-height, scroll.visible-height);
                    background: Theme.surface;

                    // Ctrl + mouse wheel zooms; plain wheel falls through to the ScrollView.
                    // shortcut: one zoom step per wheel event, so precision touchpads zoom fast; accumulate delta-y if that bothers anyone.
                    TouchArea {
                        scroll-event(event) => {
                            if (!event.modifiers.control) {
                                return reject;
                            }
                            if (event.delta-y > 0) {
                                root.zoom-in();
                            } else if (event.delta-y < 0) {
                                root.zoom-out();
                            }
                            accept
                        }
                    }

                    content := VerticalLayout {
                        width: min(page.width, root.column + 96px);
                        x: (page.width - self.width) / 2;
                        padding-left: 48px;
                        padding-right: 48px;
                        padding-top: 40px;
                        padding-bottom: 64px;
                        spacing: 0px;
                        alignment: start;

                        for block[index] in root.blocks : VerticalLayout {
                            // List items sit tight together; everything else gets paragraph spacing.
                            padding-top: index == 0 ? 0px
                                : block.kind == 12 ? 6px * root.zoom
                                : block.kind == 1 ? 32px * root.zoom
                                : block.kind == 2 ? 28px * root.zoom
                                : block.kind <= 6 ? 20px * root.zoom
                                : 14px * root.zoom;
                            spacing: 0px;

                            if block.kind == 0 : StyledText {
                                text: block.content;
                                width: 100%;
                                default-color: Theme.text-body;
                                default-font-size: block.scale * 1rem * root.zoom;
                                link-color: Theme.link;
                                selectable: true;
                                selection-background-color: Theme.selection-bg;
                                selection-foreground-color: Theme.text-main;
                                link-clicked(link) => { root.open-link(link); }
                            }

                            if block.kind >= 1 && block.kind <= 6 : VerticalLayout {
                                spacing: 8px * root.zoom;
                                Text {
                                    text: block.text;
                                    width: 100%;
                                    color: Theme.text-main;
                                    font-size: block.scale * 1rem * root.zoom;
                                    font-weight: block.kind <= 2 ? 700 : 650;
                                    wrap: word-wrap;
                                }
                                if block.kind <= 2 : Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }
                            }

                            if block.kind == 10 : Rectangle {
                                width: 100%;
                                border-radius: 8px;
                                background: Theme.code-bg;
                                border-width: 1px;
                                border-color: Theme.code-border;

                                VerticalLayout {
                                    padding: 14px * root.zoom;
                                    spacing: 6px;

                                    if block.marker != "" : Text {
                                        text: block.marker;
                                        color: Theme.text-muted;
                                        font-size: 0.7rem * root.zoom;
                                        font-family: "Consolas";
                                    }

                                    StyledText {
                                        text: block.content;
                                        width: 100%;
                                        default-color: Theme.text-body;
                                        default-font-family: "Consolas";
                                        default-font-size: block.scale * 1rem * root.zoom;
                                        selectable: true;
                                        selection-background-color: Theme.selection-bg;
                                        selection-foreground-color: Theme.text-main;
                                    }
                                }
                            }

                            if block.kind == 11 : HorizontalLayout {
                                width: 100%;
                                spacing: 14px;

                                Rectangle {
                                    width: 4px;
                                    border-radius: 2px;
                                    background: Theme.quote-bar;
                                }

                                StyledText {
                                    text: block.content;
                                    width: 100%;
                                    default-color: Theme.text-muted;
                                    default-font-size: block.scale * 1rem * root.zoom;
                                    link-color: Theme.link;
                                    selectable: true;
                                    selection-background-color: Theme.selection-bg;
                                    selection-foreground-color: Theme.text-main;
                                    link-clicked(link) => { root.open-link(link); }
                                }
                            }

                            if block.kind == 12 : HorizontalLayout {
                                width: 100%;
                                spacing: 8px;
                                padding-left: block.indent * 22px * root.zoom;

                                Text {
                                    text: block.marker;
                                    width: 22px * root.zoom;
                                    color: Theme.text-muted;
                                    font-size: block.scale * 1rem * root.zoom;
                                    horizontal-alignment: right;
                                }

                                StyledText {
                                    text: block.content;
                                    width: 100%;
                                    default-color: Theme.text-body;
                                    default-font-size: block.scale * 1rem * root.zoom;
                                    link-color: Theme.link;
                                    selectable: true;
                                    selection-background-color: Theme.selection-bg;
                                    selection-foreground-color: Theme.text-main;
                                    link-clicked(link) => { root.open-link(link); }
                                }
                            }

                            if block.kind == 13 : VerticalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }
                            }

                            if block.kind == 14 : Rectangle {
                                width: 100%;
                                border-radius: 8px;
                                background: Theme.code-bg;
                                border-width: 1px;
                                border-color: Theme.code-border;

                                VerticalLayout {
                                    padding: 14px * root.zoom;

                                    Text {
                                        text: block.text;
                                        width: 100%;
                                        color: Theme.text-body;
                                        font-size: block.scale * 1rem * root.zoom;
                                        font-family: "Consolas";
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Empty state
            if !root.has-document : Rectangle {
                vertical-stretch: 1;
                background: Theme.window-bg;

                VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 72px;
                            height: 72px;
                            border-radius: 18px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            Text {
                                text: Icons.doc;
                                font-family: Icons.font;
                                color: Theme.accent;
                                font-size: 30px;
                            }
                        }
                    }

                    Text {
                        text: "No document open";
                        color: Theme.text-main;
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Open a Markdown file to read it here.";
                        color: Theme.text-muted;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        padding-top: 6px;
                        IconButton { icon: Icons.open; label: "Open Markdown"; primary: true; clicked => { root.open-file(); } }
                        IconButton { label: "View sample"; clicked => { root.load-sample(); } }
                    }

                    Text {
                        text: "Ctrl+O to open  ·  Ctrl+Wheel or Ctrl +/- to zoom";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }
            }

            // Status bar
            Rectangle {
                height: 26px;
                background: Theme.chrome-bg;

                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: Theme.chrome-border;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 16px;

                    Text {
                        text: root.status-text;
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 40px;
                    }
                    Text {
                        text: "\{root.word-count} words";
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "\{(root.zoom * 100).round()}%";
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
          }
        }

        // Window outline drawn above the content so it is never covered.
        Rectangle {
            border-radius: frame.border-radius;
            border-width: root.maximized ? 0px : 1px;
            border-color: Theme.dark ? #3a3d43 : #c9ced6;
        }

        KeyBinding {
            keys: @keys(Control + "o");
            activated => { root.open-file(); }
        }
        KeyBinding {
            keys: @keys(Control + "r");
            activated => { root.reload(); }
        }
        KeyBinding {
            keys: @keys(Control + Shift? + "+");
            activated => { root.zoom-in(); }
        }
        KeyBinding {
            keys: @keys(Control + "=");
            activated => { root.zoom-in(); }
        }
        KeyBinding {
            keys: @keys(Control + "-");
            activated => { root.zoom-out(); }
        }
        KeyBinding {
            keys: @keys(Control + "0");
            activated => { root.zoom-reset(); }
        }
    }

    menu-popup := PopupWindow {
        x: root.width - 248px;
        y: 50px;
        width: 240px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.chrome-bg;
            border-width: 1px;
            border-color: Theme.chrome-border;
            border-radius: 8px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 4px;
            drop-shadow-blur: 16px;

            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                MenuItem { icon: Icons.open; label: "Open file"; hint: "Ctrl+O"; clicked => { menu-popup.close(); root.open-file(); } }
                MenuItem { icon: Icons.reload; label: "Reload"; hint: "Ctrl+R"; clicked => { menu-popup.close(); root.reload(); } }
                MenuItem { icon: Icons.copy; label: "Copy source"; clicked => { menu-popup.close(); root.copy-source(); } }
                Rectangle { height: 1px; background: Theme.chrome-border; }
                MenuItem { icon: Icons.zoom-in; label: "Zoom in"; hint: "Ctrl +"; clicked => { root.zoom-in(); } }
                MenuItem { icon: Icons.zoom-out; label: "Zoom out"; hint: "Ctrl -"; clicked => { root.zoom-out(); } }
                MenuItem { label: "Reset zoom"; hint: "Ctrl+0"; clicked => { menu-popup.close(); root.zoom-reset(); } }
                Rectangle { height: 1px; background: Theme.chrome-border; }
                MenuItem { icon: root.dark ? Icons.sun : Icons.moon; label: root.dark ? "Light theme" : "Dark theme"; clicked => { menu-popup.close(); root.toggle-theme(); } }
                MenuItem { icon: Icons.doc; label: "Sample document"; clicked => { menu-popup.close(); root.load-sample(); } }
                MenuItem { label: "Set default for .md"; clicked => { menu-popup.close(); root.set-default(); } }
            }
        }
    }
}
